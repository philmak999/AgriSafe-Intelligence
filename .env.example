# Free API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to a Groq model with tool-calling support
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — port for the local API server
PORT=8787

# SMTP email for automation follow-up notifications.
# Without these set, the automation loop still runs and tracks everything —
# it just marks notifications as "skipped" instead of sending them.
#
# Easiest free option — Gmail with an App Password (requires 2-Step Verification
# on the account): https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password, not your normal password>
# Any other SMTP provider (Outlook, a company mail server, Mailgun/SES SMTP, etc.)
# works the same way — just swap in its host/port/credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional — sender address shown on the email. Defaults to SMTP_USER.
SMTP_FROM=

# Required to actually send — who should receive the follow-up emails.
NOTIFY_EMAIL_TO=

# Optional — how often the automation loop runs a cycle (ms). Default: 5 minutes.
AUTOMATION_LOOP_INTERVAL_MS=300000

# Optional — how long a tracked farm is left alone before being re-reviewed (ms). Default: 12 hours.
AUTOMATION_REVIEW_INTERVAL_MS=43200000

# Base URL of the FRONTEND (the React app), used to build the "log in" link
# inside farmer approval emails. Local dev matches Vite's dev server port.
# On Render, set this to your deployed GitHub Pages URL INCLUDING the repo
# path, e.g. https://<your-username>.github.io/AgriSafe-Intelligence
APP_BASE_URL=http://localhost:5173

# Comma-separated list of frontend origins allowed to make authenticated
# requests to this API (CORS allowlist — no path, origin only). Local dev
# needs the Vite dev server; on Render, add your GitHub Pages origin, e.g.
# ALLOWED_ORIGINS=http://localhost:5173,https://<your-username>.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Set to "production" when deployed (Render sets this automatically for web
# services, but it's listed here so it's not tribal knowledge). Switches the
# session cookie to SameSite=None; Secure, which is required for the cookie
# to survive a cross-origin request — GitHub Pages and Render are different
# origins. Leave unset for local dev (same-origin via the Vite proxy).
NODE_ENV=

# Optional — how often the farmer reminder/weekly-report loop runs (ms). Default: 24 hours.
FARMER_LOOP_INTERVAL_MS=86400000

# Optional — remind a farmer when an inspection/compliance item is due within this many days
# (or already overdue). Default: 14.
REMINDER_WINDOW_DAYS=14

# Optional — minimum days between reminder emails to the same farmer, so it doesn't
# resend every cycle. Default: 3.
REMINDER_COOLDOWN_DAYS=3

# Optional — weekday (English, e.g. "Monday") weekly report emails go out. Default: Monday.
WEEKLY_REPORT_DAY=Monday

# --- Auth ---------------------------------------------------------------

# Secret used to sign login sessions. Set this to a long random string —
# anyone with this value can forge a valid session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Staff (scientist) accounts are pre-made, not self-registered. Two demo
# accounts — admin/admin (staff) and farmer/farmer (farmer) — are seeded
# automatically on every server boot if they don't already exist. See
# server/seedTestAccounts.js. Change or remove those credentials before
# deploying anywhere a stranger could reach the URL.
